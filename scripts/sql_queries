CREATE DATABASE IF NOT EXISTS rental_db;
USE rental_db;
-- apartments table
DROP TABLE IF EXISTS apartment_attributes;
CREATE TABLE apartments (
    id INT,
    title VARCHAR(255),
    source VARCHAR(50),
    price DECIMAL(10,2),
    currency VARCHAR(3),
    listing_created_on VARCHAR(255),
    is_active VARCHAR(50),
    last_modified_timestamp VARCHAR(255)
);

-- apartment_attributes table
CREATE TABLE apartment_attributes (
    id INT,
    category VARCHAR(50),
    body TEXT,
    amenities VARCHAR(255),
    bathrooms INT,
    bedrooms INT,
    fee DECIMAL(10,2),
    has_photo VARCHAR(50),
    pets_allowed VARCHAR(50),
    price_display VARCHAR(255),
    price_type VARCHAR(50),
    square_feet INT,
    address VARCHAR(255),
    cityname VARCHAR(100),
    state VARCHAR(100),
    latitude DECIMAL(10,8),
    longitude DECIMAL(11,8)
);
-- user_viewing table
DROP TABLE IF EXISTS user_viewing;
CREATE TABLE user_viewing (
    user_id INT,
    apartment_id INT,
    viewed_at VARCHAR(255),
    is_wishlisted VARCHAR(50),
    call_to_action VARCHAR(50)
);
-- bookings table
DROP TABLE IF EXISTS bookings;
CREATE TABLE bookings (
    booking_id INT,
    user_id INT,
    apartment_id INT,
    booking_date VARCHAR(20),
    checkin_date VARCHAR(20),
    checkout_date VARCHAR(20),
    total_price DECIMAL(10,2),
    currency VARCHAR(3),
    booking_status VARCHAR(50)
);


LOAD DATA FROM S3 's3://initial-lab2-bucket/imports/apartments.csv'
INTO TABLE apartments
FIELDS TERMINATED BY ','
ENCLOSED BY '"' -- <--- ADD THIS LINE
LINES TERMINATED BY '\n'
IGNORE 1 LINES;

LOAD DATA FROM S3 's3://initial-lab2-bucket/imports/apartment_attributes.csv'
INTO TABLE apartment_attributes
FIELDS TERMINATED BY ','
ENCLOSED BY '"' -- This handles quoted fields like "Balcony, Air Conditioning"
LINES TERMINATED BY '\n'
IGNORE 1 LINES;

LOAD DATA FROM S3 's3://initial-lab2-bucket/imports/bookings.csv'
INTO TABLE bookings
FIELDS TERMINATED BY ','
LINES TERMINATED BY '\n'
IGNORE 1 LINES;

LOAD DATA FROM S3 's3://initial-lab2-bucket/imports/user_viewing.csv'
INTO TABLE user_viewing
FIELDS TERMINATED BY ','
LINES TERMINATED BY '\n'
IGNORE 1 LINES;

